# Resend API Key (REQUIRED)
# Get your API key from: https://resend.com/api-keys
# Used to send contact form emails via Resend
RESEND_API_KEY=re_your_api_key_here

# Contact Form Recipient Email (OPTIONAL)
# If not set, emails will be sent to sevastosmatzouranis@gmail.com
# Use this to send contact form submissions to a different email address
CONTACT_TO_EMAIL=recipient@example.com

# Contact Form Sender Email (OPTIONAL)
# If not set, defaults to "SGM Website <onboarding@resend.dev>"
# Once you have a verified domain, you can use your own email address
CONTACT_FROM_EMAIL=SGM Website <onboarding@resend.dev>

# Cloudflare Turnstile Bot Protection (OPTIONAL)
# If not set, Vercel BotID will be used automatically on Vercel deployments
# Get your keys from: https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Google Ads Conversion Tracking (optional)
# Get these from your Google Ads account
# Format: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Get this from your Google Ads conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Google Analytics 4 (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
