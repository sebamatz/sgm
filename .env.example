# Google Ads Conversion Tracking (optional)
# Get these from your Google Ads account
# Format: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Get this from your Google Ads conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Google Analytics 4 (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Cloudflare Turnstile (for contact form anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email service (Resend)
# See app/api/contact/route.ts for email configuration
RESEND_API_KEY=
