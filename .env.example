# Gmail Configuration (REQUIRED)
# Your Gmail address that will be used to send emails
GMAIL_USER=your-email@gmail.com

# Gmail App Password (REQUIRED)
# NOT your regular Gmail password - you must create an App Password
# Instructions: https://support.google.com/accounts/answer/185833
# Prerequisites: You must have 2-Step Verification enabled on your Google account
GMAIL_APP_PASSWORD=your-16-character-app-password

# Contact Form Recipient Email (OPTIONAL)
# If not set, emails will be sent to GMAIL_USER
# Use this to send contact form submissions to a different email address
CONTACT_TO_EMAIL=recipient@example.com

# Cloudflare Turnstile Bot Protection (OPTIONAL)
# If not set, Vercel BotID will be used automatically on Vercel deployments
# Get your keys from: https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
